<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.10'>
  <model name='lingyun01'>

    <pose>0 0 0 0 0 0</pose>

    <!-- ============================================================ -->
    <!-- 灵云01号 (Lingyun01) - Gazebo Sim 仿真模型                   -->
    <!--                                                              -->
    <!-- 总体规格:                                                     -->
    <!--   起飞重量(仿真值): 2206 kg                                   -->
    <!--     (设计起飞重量仍在核算中, 暂以此值保持中性浮力)             -->
    <!--   氦气体积:     1800 m³                                      -->
    <!--   总长(含尾椎): 34.7 m                                        -->
    <!--   总宽:         18.5 m (四气囊组合)                           -->
    <!--   总高:         12.8 m (四气囊垂直堆叠)                       -->
    <!--                                                              -->
    <!-- 动力系统 (8电机):                                          -->
    <!--   升力电机x4: 垂直推力 (M0/M3向上, M1/M2向下)              -->
    <!--   推进电机x4: 水平推进+差动偏航 (两侧安装)                  -->
    <!--                                                            -->
    <!-- 升力电机新方案 (无舵机):                                    -->
    <!--   M0(前1)/M3(后2): 推力向上, 用于上升, 额定20kg            -->
    <!--   M1(前2)/M2(后1): 推力向下, 用于下降, 额定40kg            -->
    <!--                                                            -->
    <!-- 3D模型: 9个独立STL文件 (公司SolidWorks导出)                -->
    <!-- 坐标系: PX4 FLU标准 (前-左-上, 右手定则)                   -->
    <!-- ============================================================ -->

    <static>false</static>
    <self_collide>false</self_collide>

    <!-- ==================== -->
    <!-- 飞艇主体Link -->
    <!-- 原点设在SolidWorks装配坐标系原点 (FLU: X=前, Y=左, Z=上) -->
    <!-- ==================== -->
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>-0.012 -2.894 -0.009 0 0 0</pose>
        <mass>2206</mass>
        <inertia>
          <ixx>44700.0</ixx>
          <iyy>112200.0</iyy>
          <izz>145500.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <gravity>true</gravity>
      <velocity_decay/>

      <!-- ====== 四气囊主体外观 (lingyun01_hull_all.STL) ====== -->
      <visual name='hull_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/lingyun01_hull_all.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.93 0.93 0.95 0.92</ambient>
          <diffuse>0.88 0.88 0.92 0.88</diffuse>
          <specular>0.95 0.95 0.98 0.9</specular>
          <emissive>0.0 0.0 0.0 1</emissive>
        </material>
      </visual>

      <!-- ====== 碰撞体 (mesh精确外形) ====== -->
      <collision name='hull_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lingyun01/meshes/lingyun01_hull_all.STL</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.05</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>

      <!-- ====== 坐标系轴可视化 (调试用) ======
      <visual name='axis_x'>
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.03</radius><length>3</length></cylinder></geometry>
        <material><ambient>1.0 0.0 0.0 1</ambient><diffuse>1.0 0.0 0.0 1</diffuse></material>
      </visual>
      <visual name='axis_y'>
        <pose>0 1.5 0 -1.5708 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>3</length></cylinder></geometry>
        <material><ambient>0.0 1.0 0.0 1</ambient><diffuse>0.0 1.0 0.0 1</diffuse></material>
      </visual>
      <visual name='axis_z'>
        <pose>0 0 1.5 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.04</radius><length>3</length></cylinder></geometry>
        <material><ambient>0.0 0.2 1.0 1</ambient><diffuse>0.0 0.2 1.0 1</diffuse></material>
      </visual> -->

      <!-- ====== 重心可视化 (红色球体) ====== -->
      <visual name='com_visual'>
        <pose>-0.012 -2.894 -0.009 0 0 0</pose>
        <geometry><sphere><radius>0.5</radius></sphere></geometry>
        <material><ambient>1.0 0.0 0.0 1</ambient><diffuse>1.0 0.0 0.0 1</diffuse></material>
        <transparency>0.7</transparency>
      </visual>

      <!-- IMU 传感器 (安装在base_link原点, 与PX4 EKF2假设一致) -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- 磁力计传感器 (安装在base_link原点, 与PX4 EKF2假设一致) -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <!-- 气压计传感器 (安装在base_link原点) -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure>
        </air_pressure>
      </sensor>

      <!-- GPS 传感器 (安装在base_link原点) -->
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <pose>0 0 0 0 0 0</pose>
      </sensor>
    </link>

    <!-- ================================================================ -->
    <!-- 升力电机 (输出0-3) - 新方案 (无舵机)                              -->
    <!-- 结构: base_link -> rotor_joint(Z轴旋转) -> rotor link (螺旋桨)    -->
    <!--                                                                  -->
    <!-- 推力方向通过rotor_joint的旋转轴方向控制:                         -->
    <!--   axis=+Z (0 0 1): 推力向上 (上升电机)                          -->
    <!--   axis=-Z (0 0 -1): 推力向下 (下降电机)                          -->
    <!--                                                                  -->
    <!-- 升力电机配置:                                                    -->
    <!--   M0(前1): 推力向上, 用于上升, 额定20kg, motorConstant=1.416e-03 -->
    <!--   M1(前2): 推力向下, 用于下降, 额定40kg, motorConstant=-2.832e-03 -->
    <!--   M2(后1): 推力向下, 用于下降, 额定40kg, motorConstant=-2.832e-03 -->
    <!--   M3(后2): 推力向上, 用于上升, 额定20kg, motorConstant=1.416e-03 -->
    <!--                                                                  -->
    <!-- 编号规则: 前部=0/1, 后部=2/3                                     -->
    <!-- STL模型: lingyun01_lift_motor_*.STL                              -->
    <!-- ================================================================ -->

    <!-- ==================== -->
    <!-- 升力电机0: 前部升力电机1 (front1) - 推力向上 -->
    <!-- STL使用SW绝对坐标(螺旋桨轴沿X), 需旋转-90°Y使轴朝上Z -->
    <!-- rotor使用STL绝对坐标+旋转 -->
    <!-- ==================== -->

    <!-- 螺旋桨link: link pose定义物理推力点, visual/collision pose=负偏移(补偿STL绝对坐标) -->
    <link name='rotor_0'>
      <pose>11.225 -2.894 0.331 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='rotor_0_visual'>
        <pose>-11.225 2.894 -0.331 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/lingyun01_lift_motor_front1.STL</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name='rotor_0_collision'>
        <pose>-11.225 2.894 -0.331 0 0 0</pose>
        <geometry><cylinder><radius>0.8</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
    </link>

    <!-- 螺旋桨旋转关节: parent=base_link, axis=+Z(推力向上) -->
    <joint name='rotor_0_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== -->
    <!-- 升力电机1: 前部升力电机2 (front2) - 推力向下 -->
    <!-- STL绝对坐标: +9.21, -2.89, +0.33 -->
    <!-- ==================== -->

    <link name='rotor_1'>
      <pose>9.215 -2.894 0.331 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='rotor_1_visual'>
        <pose>-9.215 2.894 -0.331 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/lingyun01_lift_motor_front2.STL</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name='rotor_1_collision'>
        <pose>-9.215 2.894 -0.331 0 0 0</pose>
        <geometry><cylinder><radius>0.8</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
    </link>

    <!-- 螺旋桨旋转关节: parent=base_link, axis=+Z, motorConstant为负产生向下推力 -->
    <joint name='rotor_1_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== -->
    <!-- 升力电机2: 后部升力电机1 (back1) - 推力向下 -->
    <!-- STL绝对坐标: -13.54, -2.89, +0.33 -->
    <!-- ==================== -->

    <link name='rotor_2'>
      <pose>-13.535 -2.894 0.331 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='rotor_2_visual'>
        <pose>13.535 2.894 -0.331 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/lingyun01_lift_motor_back1.STL</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name='rotor_2_collision'>
        <pose>13.535 2.894 -0.331 0 0 0</pose>
        <geometry><cylinder><radius>0.8</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
    </link>

    <!-- 螺旋桨旋转关节: parent=base_link, axis=+Z, motorConstant为负产生向下推力 -->
    <joint name='rotor_2_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- ==================== -->
    <!-- 升力电机3: 后部升力电机2 (back2) - 推力向上 -->
    <!-- STL绝对坐标: -15.53, -2.89, +0.33 -->
    <!-- ==================== -->

    <link name='rotor_3'>
      <pose>-15.525 -2.894 0.331 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='rotor_3_visual'>
        <pose>15.525 2.894 -0.331 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/lingyun01_lift_motor_back2.STL</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name='rotor_3_collision'>
        <pose>15.525 2.894 -0.331 0 0 0</pose>
        <geometry><cylinder><radius>0.8</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
    </link>

    <!-- 螺旋桨旋转关节: parent=base_link, axis=+Z(推力向上) -->
    <joint name='rotor_3_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- ================================ -->
    <!-- 推进电机 (输出4-7)                 -->
    <!-- 安装位置: 飞艇下部               -->
    <!-- 功能: 水平推进+差动偏航 (X轴方向) -->
    <!-- STL模型: lingyun01_thrust_motor_*.STL -->
    <!-- 注意: 推进电机link旋转90度绕Y轴, 使Z轴指向前方(X轴), 推力沿Z轴施加即向前 -->
    <!-- ================================ -->

    <!-- 推进电机0: 左前推进电机 (LF) [STL绝对坐标: +2.55, +2.39, -1.51] -->
    <!-- link pose绕Y轴+90度: 使link局部Z轴指向base_link +X方向(推力向前) -->
    <!-- visual/collision pose: 补偿link旋转, 使mesh在世界坐标系中位置正确 -->
    <link name='rotor_4'>
      <pose>2.55 2.39 -1.51 0 1.5708 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='rotor_4_visual'>
        <pose>-1.51 -2.39 -2.55 0 -1.5708 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/lingyun01_thrust_motor_LF.STL</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name='rotor_4_collision'>
        <pose>-1.51 -2.39 -2.55 0 -1.5708 0</pose>
        <geometry><cylinder><radius>1.0</radius><length>0.08</length></cylinder></geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
    </link>
    <joint name='rotor_4_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_4</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- 推进电机1: 左后推进电机 (LB) [STL绝对坐标: -2.55, +2.39, -1.51] -->
    <link name='rotor_5'>
      <pose>-2.55 2.39 -1.51 0 1.5708 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='rotor_5_visual'>
        <pose>-1.51 -2.39 2.55 0 -1.5708 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/lingyun01_thrust_motor_LB.STL</uri>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/DarkGrey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <collision name='rotor_5_collision'>
        <pose>-1.51 -2.39 2.55 0 -1.5708 0</pose>
        <geometry><cylinder><radius>1.0</radius><length>0.08</length></cylinder></geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
    </link>
    <joint name='rotor_5_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_5</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

    <!-- 推进电机2: 右前推进电机 (RF) [STL绝对坐标: +2.55, -8.19, -1.51] -->
    <link name='rotor_6'>
      <pose>2.55 -8.19 -1.51 0 1.5708 0</pose>
      <gravity>false</gravity>
