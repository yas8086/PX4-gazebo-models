    <!-- ================================================================
         风机/阀门固定关节 (V2修复)
         8个风机/阀门link此前无joint连接base_link, 飞艇移动时留在原地.
         添加fixed joint使其跟随base_link一起运动.
         child link的pose即为相对base_link的位置.
         ================================================================ -->
    <joint name='blower_main_left_joint' type='fixed'>
      <parent>base_link</parent>
      <child>blower_main_left</child>
    </joint>
    <joint name='valve_main_left_joint' type='fixed'>
      <parent>base_link</parent>
      <child>valve_main_left</child>
    </joint>
    <joint name='blower_main_right_joint' type='fixed'>
      <parent>base_link</parent>
      <child>blower_main_right</child>
    </joint>
    <joint name='valve_main_right_joint' type='fixed'>
      <parent>base_link</parent>
      <child>valve_main_right</child>
    </joint>
    <joint name='blower_aux_left_joint' type='fixed'>
      <parent>base_link</parent>
      <child>blower_aux_left</child>
    </joint>
    <joint name='valve_aux_left_joint' type='fixed'>
      <parent>base_link</parent>
      <child>valve_aux_left</child>
    </joint>
    <joint name='blower_aux_right_joint' type='fixed'>
      <parent>base_link</parent>
      <child>blower_aux_right</child>
    </joint>
    <joint name='valve_aux_right_joint' type='fixed'>
      <parent>base_link</parent>
      <child>valve_aux_right</child>
    </joint>

    <!-- ==================== -->
    <!-- 电机插件配置       -->
    <!-- ==================== -->

    <!-- 上升电机插件 (rotor_0~3): 推力向上 (沿局部+Z) -->
    <!-- T-MOTOR A10 (KV120), 最大推力 222.5N (22.7kg) -->
    <!-- motorConstant = 222.5 / 372^2 = 1.608e-03 (占位, 待用户提供实际转速) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.2</timeConstantUp>
      <timeConstantDown>0.3</timeConstantDown>
      <maxRotVelocity>372.0</maxRotVelocity>
      <motorConstant>1.608e-03</motorConstant>
      <!-- V2修复: 反扭矩系数0.002->8e-5. 反扭矩/推力等效力臂=momentConstant/motorConstant
           =1.24m, 真实螺旋桨约0.05m(过大25倍). 差动控制时泄漏伪偏航力矩~300N·m,
           加剧姿态轴间耦合振荡 -->
      <momentConstant>8e-5</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.06428e-03</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-05</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

