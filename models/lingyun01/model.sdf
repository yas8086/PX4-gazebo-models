    <!-- ==================== -->
    <!-- 飞艇气动力插件       -->
    <!-- ==================== -->
    <plugin filename="/home/hex/PX4-Autopilot/Tools/simulation/gz/plugins/airship_dynamics/build/libAirshipDynamics.so" name="gz::sim::systems::AirshipDynamics">
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <hull_volume>1800.0</hull_volume>
      <net_buoyancy>0</net_buoyancy>
      <buoyancy_offset>-0.012 -2.894 -0.009</buoyancy_offset>
      <buoyancy_center>-0.012 -2.894 -0.009</buoyancy_center>
      <force_inviscid_coeff>5.0</force_inviscid_coeff>
      <force_viscous_coeff>270.0</force_viscous_coeff>
      <moment_inviscid_coeff>400.0</moment_inviscid_coeff>
      <moment_viscous_coeff>200.0</moment_viscous_coeff>
      <eps_v>0.5</eps_v>
      <axial_drag_coeff>3.0</axial_drag_coeff>
      <dist_cov>0.0</dist_cov>
      <tether_stiffness>0</tether_stiffness>
      <tether_damping>0</tether_damping>
      <tether_anchor>-0.012 -2.894 0</tether_anchor>
      <m11>187</m11>
      <m22>1496</m22>
      <m33>787</m33>
      <m44>5000</m44>
      <m55>5000</m55>
      <m66>5000</m66>
      <!-- 旋转阻尼系数 (N·m·s/rad) - 基于等效椭球体模型计算 -->
      <!-- 飞艇等效椭球体: a=17.35m, b=9.25m, c=6.4m, V=1800m³ -->
      <!-- 公式: C_rot = 0.5 × ρ × V^(2/3) × L² × C_l_rot -->
      <!-- X轴(Roll): L=12.8m, C_l_rot=0.10, 基础值14840, 四气囊修正×3.0=45000 -->
      <rot_damping_x>45000</rot_damping_x>
      <!-- Y轴(Pitch): L=34.7m, C_l_rot=0.20, 计算值216631≈220000 -->
      <rot_damping_y>220000</rot_damping_y>
      <!-- Z轴(Yaw): L=18.5m, C_l_rot=0.15, 基础值46378, 四气囊修正×3.0=140000 -->
      <rot_damping_z>140000</rot_damping_z>
      <!-- 四气囊参数 (统一浮力调节) -->
      <ballast_mass_max>128.5</ballast_mass_max>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/lingyun01/joint_state</topic>
    </plugin>

  </model>
</sdf>
