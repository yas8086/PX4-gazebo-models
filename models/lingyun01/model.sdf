    <!-- ================================================================ -->
    <!-- 推进电机 (rotor_6~9, 输出6-9) - 水平推进+差动偏航                -->
    <!--   rotor_6 推进左前 (FLU: 2.230, 5.888, -2.378)   CW              -->
    <!--   rotor_7 推进右前 (FLU: 2.230, -5.887, -2.378)  CCW            -->
    <!--   rotor_8 推进左后 (FLU: -2.971, 5.888, -2.378)  CW             -->
    <!--   rotor_9 推进右后 (FLU: -2.972, -5.887, -2.378) CCW           -->
    <!--                                                              -->
    <!-- 推力方向: link pose绕Y轴+90度, 使局部Z轴指向FLU +X (向前)     -->
    <!-- 旋转轴: joint axis=(0,0,1) (局部Z=FLU X, 绕前后轴旋转)       -->
    <!-- visual/collision pose = R_y(-90) 补偿link旋转                -->
    <!--   t_V = -R_y(-90) * t_L, R_V = R_y(-90)                      -->
    <!-- ================================================================ -->

    <link name='rotor_6'>
      <pose>2.230 5.888 -2.378 0 1.5708 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='rotor_6_visual'>
        <pose>-2.378 -5.888 -2.230 0 -1.5708 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/V2_FLU/thrust_lf.STL</uri>
          </mesh>
        </geometry>
        <material>
          <!-- 螺旋桨: 纯黑不透明 + 双面渲染 -->
          <!-- 双面渲染修复薄壳结构只有边线黑的问题 (背面被剔除看不到主体) -->
          <!-- ambient/diffuse 从0.05调到0.02, 视觉上是纯黑而不是发灰的深灰 -->
          <ambient>0.02 0.02 0.02 1.0</ambient>
          <diffuse>0.02 0.02 0.02 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
          <double_sided>true</double_sided>
        </material>
      </visual>
      <collision name='rotor_6_collision'>
        <pose>-2.378 -5.888 -2.230 0 -1.5708 0</pose>
        <geometry><cylinder><radius>1.0</radius><length>0.08</length></cylinder></geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
    </link>
    <joint name='rotor_6_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_6</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

