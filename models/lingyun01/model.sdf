    <!-- 右外副囊RO: 风机 + 阀门 (Y=-8.6, Z中心=-0.66, 短轴R=2.5) -->
    <!-- 底部Z = -0.66 - 2.5 = -3.158, 风机Z = -3.158 + 1 = -2.158  -->
