    <!-- 推进电机插件 (rotor_6~9): 水平推力向前 (link旋转后局部Z=FLU X) -->
    <!-- HOBBYWING P65M, 最大推力 1352.4N (138kg) -->
    <!-- motorConstant = 1352.4 / 394.8^2 = 8.677e-03 (占位, 待用户提供实际转速) -->
    <!-- 旋转方向: 左侧CW, 右侧CCW (左右对转, 滚转反扭矩抵消) -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_6_joint</jointName>
      <linkName>rotor_6</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.15</timeConstantUp>
      <timeConstantDown>0.2</timeConstantDown>
      <maxRotVelocity>394.8</maxRotVelocity>
      <motorConstant>8.677e-03</motorConstant>
      <!-- V2修复: 反扭矩系数0.02->4.3e-4. 原等效力臂2.3m(真实约0.05m,过大46倍).
           推进电机差动偏航时泄漏伪横滚力矩~800N·m, 加剧横滚振荡 -->
      <momentConstant>4.3e-4</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <motorNumber>6</motorNumber>
      <rotorDragCoefficient>8.06428e-03</rotorDragCoefficient>
      <rollingMomentCoefficient>0</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
      <motorType>velocity</motorType>
    </plugin>

