    <!-- 推进电机3: 右后推进电机 (RB) [STL绝对坐标: -2.55, -8.19, -1.51] -->
    <link name='rotor_7'>
      <pose>-2.55 -8.19 -1.51 0 1.5708 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
