    <!-- ================================================================ -->
    <!-- 风机/阀门可视化占位 (4风机 + 4阀门, 每囊1风机1阀门)            -->
    <!-- 位置: X统一=0(椭球几何中心, 长轴沿X),                           -->
    <!--       Y=各囊相对STL中心Y=0(即base_link原点)的左右偏移:          -->
    <!--         主囊偏移3.3m, 副囊偏移8.6m (两侧对称, SolidWorks实测)   -->
    <!--       Z=各囊底部+1m(底部=椭球Z中心 - 短轴半径)                -->
    <!-- 短轴半径: 主囊=3.1m, 副囊=2.5m(用户提供)                      -->
    <!-- STL实测(convert_stl_to_flu.py平移到中心): 主囊Y=±3.15, 副囊Y=±8.9 -->
    <!--                                                                      -->
    <!--  FLU_Y+ (左) ---------- Y增大方向 -------> FLU_Y- (右)            -->
    <!--  [LO左外副囊]  [LI左内主囊]  [RI右内主囊]  [RO右外副囊]           -->
    <!--   Y=+8.6       Y=+3.3       Y=-3.3       Y=-8.6                  -->
    <!--   短轴R=2.5m    短轴R=3.1m    短轴R=3.1m    短轴R=2.5m            -->
    <!--   底Z=-3.158    底Z=-2.651    底Z=-2.651    底Z=-3.158             -->
    <!--   风机Z=-2.158  风机Z=-1.651  风机Z=-1.651  风机Z=-2.158          -->
    <!--   阀门Z=-2.458  阀门Z=-1.951  阀门Z=-1.951  阀门Z=-2.458          -->
    <!--                                                                      -->
    <!-- 风机=绿色圆柱(鼓风), 阀门=黄色圆盘(开闭), 风机在上/阀门在下      -->
    <!-- 尺寸: 原始尺寸30% (50% x 70%), 风机R=0.14/L=0.21, 阀R=0.07/L=0.105 -->
    <!-- 仅可视化占位, 物理作用由AirshipDynamics插件执行器状态实现         -->
    <!-- ==================================================================== -->

    <!-- 左内主囊LI: 风机 + 阀门 (Y=+3.3, Z中心=+0.45, 短轴R=3.1) -->
    <!-- 底部Z = 0.45 - 3.1 = -2.651, 风机Z = -2.651 + 1 = -1.651    -->
    <link name='blower_main_left'>
      <pose>0 3.3 -1.651 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='blower_main_left_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.14</radius><length>0.21</length></cylinder></geometry>
        <material><ambient>0.0 0.9 0.3 1</ambient><diffuse>0.0 0.7 0.2 1</diffuse></material>
      </visual>
    </link>
    <link name='valve_main_left'>
      <pose>0 3.3 -1.951 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='valve_main_left_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry><cylinder><radius>0.07</radius><length>0.105</length></cylinder></geometry>
        <material><ambient>1.0 0.9 0.1 1</ambient><diffuse>0.8 0.7 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- 右内主囊RI: 风机 + 阀门 (Y=-3.3, Z中心=+0.45, 短轴R=3.1) -->
    <!-- 底部Z = 0.45 - 3.1 = -2.651, 风机Z = -2.651 + 1 = -1.651    -->
    <link name='blower_main_right'>
