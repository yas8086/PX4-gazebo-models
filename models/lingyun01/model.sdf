<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.10'>
  <model name='lingyun01'>

    <pose>0 0 0 0 0 0</pose>

    <!-- ============================================================ -->
    <!-- 灵云01号 (Lingyun01) V2 - Gazebo Sim 仿真模型               -->
    <!--                                                              -->
    <!-- 总体规格:                                                     -->
    <!--   起飞重量(仿真值): 2206 kg                                   -->
    <!--     (设计起飞重量仍在核算中, 暂以此值保持中性浮力)             -->
    <!--   氦气体积:     1800 m³                                      -->
    <!--   总长(含尾椎): 34.7 m                                        -->
    <!--   总宽:         18.5 m (四气囊组合)                           -->
    <!--   总高:         12.8 m                                       -->
    <!--   重心(暂定): 艇身包围盒中心下方1.5m                          -->
    <!--     base_link原点 = 艇身包围盒中心 (FLU)                      -->
    <!--     重心 = (0, 0, -1.5) FLU (X前, Y左, Z上)                  -->
    <!--                                                              -->
    <!-- 动力系统 (10电机):                                            -->
    <!--   上升电机x4 (rotor_0~3): 推力向上, 四角布局                  -->
    <!--   下降电机x2 (rotor_4~5): 推力向下, 中轴前后                  -->
    <!--   推进电机x4 (rotor_6~9): 水平推进+差动偏航                   -->
    <!--                                                              -->
    <!-- 执行器: 4风机 + 4阀门 (每囊1风机1阀门)                        -->
    <!--   充气 = 风机+阀门 (鼓风), 排气 = 仅阀门 (自然排气)           -->
    <!--                                                              -->
    <!-- 坐标系: PX4 FLU标准 (前-左-上, 右手定则)                     -->
    <!--   V2 STL由SW坐标系(毫米)预转换 (见 meshes/convert_stl_to_flu.py): -->
    <!--     FLU_X = SW_Y/1000, FLU_Y = -SW_X/1000, FLU_Z = SW_Z/1000  -->
    <!--     再平移到相对主体中心 (主体中心在原点)                     -->
    <!--   转换后STL位于 meshes/V2_FLU/ (米, FLU, 相对主体中心)       -->
    <!-- ============================================================ -->

    <static>false</static>
    <self_collide>false</self_collide>

    <!-- ==================== -->
    <!-- 飞艇主体Link -->
    <!-- 原点 = 艇身包围盒中心 (FLU: X=前, Y=左, Z=上) -->
    <!-- 重心 = (0, 0, -1.5) FLU -->
    <!-- ==================== -->
    <link name='base_link'>
      <pose>0 0 0 0 0 0</pose>

      <inertial>
        <pose>0 0 -1.5 0 0 0</pose>
        <mass>2206</mass>
        <inertia>
          <ixx>44700.0</ixx>
          <iyy>112200.0</iyy>
          <izz>145500.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <gravity>true</gravity>
      <velocity_decay/>

      <!-- ====== 四囊主体外观 (hull_all.STL, 中心在原点) ====== -->
      <visual name='hull_visual'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/V2_FLU/hull_all.STL</uri>
          </mesh>
        </geometry>
        <material>
          <!-- V1版本奶白色材质: 偏蓝一点点的奶白 (R0.93 G0.93 B0.95) -->
          <!-- 修复: ambient alpha 从0.92改为1.0, 消除半透明渲染导致的   -->
          <!-- 左右渲染不一致(半透明深度排序问题会让一侧露出内部物体)   -->
          <!-- 修复2: double_sided=true 双面渲染, 消除双层壳STL中法线朝内 -->
          <!-- 面被背面剔除导致的"看穿到内层"(左侧透明发灰现象)         -->
          <ambient>0.93 0.93 0.95 1.0</ambient>
          <diffuse>0.93 0.93 0.95 1.0</diffuse>
          <double_sided>true</double_sided>
        </material>
      </visual>

      <!-- ====== 碰撞体 (mesh精确外形) ====== -->
      <collision name='hull_collision'>
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://lingyun01/meshes/V2_FLU/hull_all.STL</uri>
          </mesh>
        </geometry>
        <surface>
          <contact>
            <ode>
              <min_depth>0.05</min_depth>
              <max_vel>0</max_vel>
            </ode>
          </contact>
          <friction>
            <ode/>
          </friction>
        </surface>
      </collision>

      <!-- ====== 重心可视化 (红色球体) ====== -->
      <visual name='com_visual'>
        <pose>0 0 -1.5 0 0 0</pose>
        <geometry><sphere><radius>0.5</radius></sphere></geometry>
        <material><ambient>1.0 0.0 0.0 1</ambient><diffuse>1.0 0.0 0.0 1</diffuse></material>
        <transparency>0.7</transparency>
      </visual>

      <!-- IMU 传感器 (安装在重心, 与PX4 EKF2假设一致) -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>250</update_rate>
        <pose>0 0 -1.5 0 0 0</pose>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.0008726646</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>0.00637</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>0.00686</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>

      <!-- 磁力计传感器 (安装在重心) -->
      <sensor name="magnetometer_sensor" type="magnetometer">
        <always_on>1</always_on>
        <update_rate>100</update_rate>
        <pose>0 0 -1.5 0 0 0</pose>
        <magnetometer>
          <x><noise type="gaussian"><stddev>0.0001</stddev></noise></x>
          <y><noise type="gaussian"><stddev>0.0001</stddev></noise></y>
          <z><noise type="gaussian"><stddev>0.0001</stddev></noise></z>
        </magnetometer>
      </sensor>

      <!-- 气压计传感器 (安装在重心) -->
      <sensor name="air_pressure_sensor" type="air_pressure">
        <always_on>1</always_on>
        <update_rate>50</update_rate>
        <pose>0 0 -1.5 0 0 0</pose>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>3</stddev></noise></pressure>
        </air_pressure>
      </sensor>

      <!-- GPS 传感器 (安装在重心) -->
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <pose>0 0 -1.5 0 0 0</pose>
      </sensor>
    </link>

    <!-- ================================================================ -->
    <!-- 上升电机 (rotor_0~3, 输出0-3) - 推力向上, 四角布局               -->
    <!--   rotor_0 上升左前 (FLU: 7.557, 6.338, -0.584)   CCW             -->
    <!--   rotor_1 上升右前 (FLU: 7.557, -6.337, -0.584)  CW              -->
    <!--   rotor_2 上升左后 (FLU: -9.843, 5.814, -0.584)  CW              -->
    <!--   rotor_3 上升右后 (FLU: -9.843, -5.812, -0.584) CCW            -->
    <!--   推力沿局部+Z (FLU Z向上), joint axis=(0,0,1)                   -->
    <!--   motorConstant>0: 推力沿+Z (向上, 上升)                         -->
    <!-- ================================================================ -->

    <link name='rotor_0'>
      <pose>7.557 6.338 -0.584 0 0 0</pose>
      <gravity>false</gravity>
      <self_collide>false</self_collide>
      <velocity_decay/>
      <inertial>
        <mass>1e-8</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name='rotor_0_visual'>
        <pose>-7.557 -6.338 0.584 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>file:///home/hex/PX4-Autopilot/Tools/simulation/gz/models/lingyun01/meshes/V2_FLU/lift_up_lf.STL</uri>
          </mesh>
        </geometry>
        <material>
          <!-- 螺旋桨: 纯黑不透明 + 双面渲染 -->
          <!-- 双面渲染修复薄壳结构只有边线黑的问题 (背面被剔除看不到主体) -->
          <!-- ambient/diffuse 从0.05调到0.02, 视觉上是纯黑而不是发灰的深灰 -->
          <ambient>0.02 0.02 0.02 1.0</ambient>
          <diffuse>0.02 0.02 0.02 1.0</diffuse>
          <specular>0.2 0.2 0.2 1.0</specular>
          <double_sided>true</double_sided>
        </material>
      </visual>
      <collision name='rotor_0_collision'>
        <pose>-7.557 -6.338 0.584 0 0 0</pose>
        <geometry><cylinder><radius>0.8</radius><length>0.05</length></cylinder></geometry>
        <surface>
          <contact><ode><min_depth>0.001</min_depth><max_vel>0</max_vel></ode></contact>
          <friction><ode/></friction>
        </surface>
      </collision>
    </link>
    <joint name='rotor_0_joint' type='revolute'>
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e+16</lower>
          <upper>1e+16</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>

