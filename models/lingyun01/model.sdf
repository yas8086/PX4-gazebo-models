    <!-- ==================== -->
    <!-- 飞艇气动力插件       -->
    <!-- ==================== -->
    <plugin filename="/home/hex/PX4-Autopilot/Tools/simulation/gz/plugins/airship_dynamics/build/libAirshipDynamics.so" name="gz::sim::systems::AirshipDynamics">
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <hull_volume>1800.0</hull_volume>
      <!-- V2修复: net_buoyancy 0->+10N, 补偿实测微负净浮力(-9.8N, 浮力21609 vs 重力21618.8),
           回到中性浮力; 该静态值作为基准与 ballast_cmd 动态调节量叠加(AirshipDynamics) -->
      <net_buoyancy>10</net_buoyancy>
      <!-- V2定稿: buoyancy_center上移至重心上方0.5m(0,0,-1.0), 形成摆锤被动稳定
           (重心=浮力中心时横滚/俯仰中性不稳定, 控制两难: 漂移或耦合振荡) -->
      <buoyancy_offset>0 0 -1.5</buoyancy_offset>
      <buoyancy_center>0 0 -1.0</buoyancy_center>
      <force_inviscid_coeff>5.0</force_inviscid_coeff>
      <force_viscous_coeff>270.0</force_viscous_coeff>
      <moment_inviscid_coeff>400.0</moment_inviscid_coeff>
      <moment_viscous_coeff>200.0</moment_viscous_coeff>
      <eps_v>0.5</eps_v>
      <!-- V2修复: 轴向阻力系数3.0->30, 配合三轴分解(AirshipDynamics),
           垂直运动也受阻力约束, 防止飞艇垂直/水平速度失控快速运动 -->
      <axial_drag_coeff>30.0</axial_drag_coeff>
      <dist_cov>0.0</dist_cov>
      <tether_stiffness>0</tether_stiffness>
      <tether_damping>0</tether_damping>
      <tether_anchor>0 0 -1.5</tether_anchor>
      <m11>187</m11>
      <m22>1496</m22>
      <m33>787</m33>
      <m44>5000</m44>
      <m55>5000</m55>
      <m66>5000</m66>
      <!-- 旋转阻尼系数 (N·m·s/rad) - 基于等效椭球体模型计算 -->
      <!-- V2调参: rot_damping_z 140000->30000 (Position模式转向极慢0.125°/s, 降低后0.44°/s) -->
      <rot_damping_x>45000</rot_damping_x>
      <rot_damping_y>220000</rot_damping_y>
      <rot_damping_z>30000</rot_damping_z>
      <!-- 四气囊参数 (统一浮力调节, 4囊同步) -->
      <ballast_mass_max>128.5</ballast_mass_max>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/model/lingyun01/joint_state</topic>
    </plugin>

  </model>
</sdf>
