<?xml version="1.0"?>
<model>
  <name>Lingyun01 Airship</name>
  <version>1.0</version>
  <sdf version="1.10">model.sdf</sdf>
  <author>
   <name>Lingyun Jingjie</name>
   <email>contact@lingyunjingjie.com</email>
  </author>
  <description>
    Lingyun01: Hybrid lift/propulsion airship with neutral buoyancy.

    Features:
    - 4 helium envelopes (1800 m3 total volume)
    - 10 motors (6 lift motors + 4 thrust motors)
    - 4 air ballast envelopes with 4 blowers + 4 valves (height control only)
    - Solar panels (60kW)
    - Neutral buoyancy design (zero net buoyancy)

    Specifications:
    - Total length: 34.7 m
    - Total width: 20.4 m
    - Total height: 7.9 m
    - Takeoff weight (sim placeholder): 2206 kg (design weight under review; placeholder value used to maintain neutral buoyancy)
    - Propulsion: 4x15kW P65M thrust + 6x1.5kW A10 lift
  </description>
</model>
